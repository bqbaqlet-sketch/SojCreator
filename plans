// Көлем үлгілері: "Беттер саны" тізіміндегі әр таңдау осы жерде сипатталған.
// Сөз саны Word-тағы Times New Roman 12 pt, қарапайым (жирный емес),
// бір интервал, A4 бойынша өлшенген: 1 бет ≈ 450 сөз.
// "pages" = тек мәтін (Кіріспе...Әдебиеттер), титул мен жоспар кірмейді.

const PLANS = {
  // Колледж регламенті: Кіріспе = 1 бет, Негізгі бөлім = 1.5 бет
  standard: {
    label: "Стандарт",
    kirispe: 450,
    negizgi: 1300, // 3 толық бетті толтыру үшін (бос орынсыз)
    subsections: 4,
    qorytyndy: 400, // 1 бет, бірақ одан кейін әдебиеттер тізімі сол бетте сыюы үшін сәл қор қалдырылды
    // Кіріспе дәл 1 бет болуы үшін Негізгі бөлім жаңа беттен басталады
    pageBreakBeforeNegizgi: true,
  },
};

function getPlan(key) {
  return PLANS[String(key)] || PLANS.standard;
}

module.exports = { PLANS, getPlan };
