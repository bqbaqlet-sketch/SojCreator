// Бөлімдердің көлемін таңдалған үлгіге (plans.js) сай ұстап тұру.
// Өлшеу нәтижесі (Times New Roman 12 pt, жирный, бір интервал, A4):
//   1 бет ≈ 420 сөз.

function countWords(text) {
  return (text || "").split(/\s+/).filter(Boolean).length;
}

// Мәтінді maxWords сөзге дейін қысқартады: тек толық сөйлемдерді қалдырады
function trimText(text, maxWords) {
  if (countWords(text) <= maxWords) return text;

  const paragraphs = text.split(/\n+/).filter((p) => p.trim());
  const kept = [];
  let used = 0;

  for (const para of paragraphs) {
    const words = countWords(para);
    if (used + words <= maxWords) {
      kept.push(para);
      used += words;
      continue;
    }
    // абзацты сөйлемдерге бөліп, сыйғанын ғана аламыз
    const sentences = para.split(/(?<=[.!?…])\s+/);
    const partial = [];
    for (const s of sentences) {
      const w = countWords(s);
      if (used + w > maxWords) break;
      partial.push(s);
      used += w;
    }
    if (partial.length) kept.push(partial.join(" "));
    break;
  }
  return kept.join("\n\n");
}

function negizgiWords(blocks) {
  return (blocks || []).reduce((sum, b) => sum + countWords(b.matin), 0);
}

// Үлгіден шектерді есептейді
function limitsFor(plan) {
  return {
    kirispeMax: Math.round(plan.kirispe * 1.035), // 400 -> 414
    kirispeMin: Math.round(plan.kirispe * 0.85),
    negizgiMax: Math.round(plan.negizgi * 1.07), // 590 -> 631
    negizgiMin: Math.round(plan.negizgi * 0.85),
    qorytyndyMax: Math.round(plan.qorytyndy * 1.035), // Кіріспемен бірдей ереже
    qorytyndyMin: Math.round(plan.qorytyndy * 0.85),
  };
}

// Мәтін тым қысқа болса true
function isTooShort(content, plan) {
  const L = limitsFor(plan);
  return (
    countWords(content.kirispe) < L.kirispeMin ||
    negizgiWords(content.negizgi_bolim) < L.negizgiMin ||
    countWords(content.qorytyndy) < L.qorytyndyMin
  );
}

// Тым ұзын болса — толық сөйлемдермен қысқартады
function fitContent(content, plan) {
  const L = limitsFor(plan);
  const fitted = { ...content };
  fitted.kirispe = trimText(content.kirispe || "", L.kirispeMax);

  // Артық болса, барлық ішкі бөлімдерді пропорционалды қысқартамыз,
  // сонда барлық тақырыпшалар қалады
  const src = content.negizgi_bolim || [];
  const total = negizgiWords(src);
  const ratio = total > L.negizgiMax ? L.negizgiMax / total : 1;
  fitted.negizgi_bolim = src.map((b) => ({
    ...b,
    matin: trimText(b.matin || "", Math.floor(countWords(b.matin) * ratio)),
  }));

  // Қорытынды тым ұзақ болмасын
  fitted.qorytyndy = trimText(content.qorytyndy || "", L.qorytyndyMax);
  return fitted;
}

module.exports = { fitContent, isTooShort, countWords, limitsFor };
